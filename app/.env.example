# Copy to .env for local runs. On AWS these values come from SSM Parameter Store.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_VERIFY_TOKEN=
ANTHROPIC_API_KEY=

# Single-calendar mode (optional when business_config lists several professionals)
GOOGLE_CALENDAR_ID=

# Google service account: a file path (local) OR the full JSON inline (containers)
GOOGLE_CREDENTIALS_JSON=credentials.json
GOOGLE_CREDENTIALS_CONTENT=

# Optional: full clinic config as JSON; overrides business_config.json
BUSINESS_CONFIG=
